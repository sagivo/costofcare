---
const { title = 'CostOfCare - Know what care costs before you go', description = 'Real, published healthcare prices for Austin, TX. Compare hospitals, imaging centers and labs before you book.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<style>
  :root {
    --ink: #12212e; --muted: #5b6b78; --line: #e3eaef; --bg: #f7fafb;
    --brand: #0e7a6d; --brand-dark: #0a5c52; --accent: #d97706;
    --good: #0e7a6d; --warn-bg: #fef6e7; --card: #ffffff;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: var(--ink); background: var(--bg); line-height: 1.55; }
  a { color: var(--brand); }
  header.site { background: var(--card); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 10; }
  .wrap { max-width: 980px; margin: 0 auto; padding: 0 16px; }
  header.site .wrap { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .logo { font-weight: 800; font-size: 1.15rem; text-decoration: none; color: var(--ink); }
  .logo span { color: var(--brand); }
  nav.top a { margin-left: 16px; text-decoration: none; color: var(--muted); font-size: 0.95rem; }
  nav.top a:hover { color: var(--brand); }
  main { padding: 24px 0 64px; }
  h1 { font-size: 1.9rem; line-height: 1.2; letter-spacing: -0.02em; }
  h2 { font-size: 1.3rem; margin: 28px 0 12px; }
  .sub { color: var(--muted); margin-top: 8px; max-width: 640px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 18px; }
  .pill { display: inline-block; font-size: 0.78rem; font-weight: 600; padding: 3px 10px; border-radius: 999px; background: #e6f4f1; color: var(--brand-dark); }
  .pill.warn { background: var(--warn-bg); color: var(--accent); }
  table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  tr.best td { background: #e6f4f1; }
  .price { font-weight: 700; white-space: nowrap; }
  .best-tag { display: inline-block; font-size: 0.72rem; font-weight: 700; color: #fff; background: var(--good); border-radius: 6px; padding: 2px 7px; margin-left: 6px; }
  .muted { color: var(--muted); font-size: 0.88rem; }
  footer.site { border-top: 1px solid var(--line); padding: 28px 0 48px; color: var(--muted); font-size: 0.85rem; }
  .grid { display: grid; gap: 12px; grid-template-columns: 1fr; }
  @media (min-width: 680px) { .grid.cols3 { grid-template-columns: repeat(3, 1fr); } .grid.cols2 { grid-template-columns: repeat(2, 1fr); } h1 { font-size: 2.5rem; } }
</style>
</head>
<body>
<header class="site">
  <div class="wrap">
    <a class="logo" href="/">Cost<span>Of</span>Care</a>
    <nav class="top">
      <a href="/#labs">Labs</a>
      <a href="/#imaging">Imaging</a>
      <a href="/#visits">ER visits</a>
      <a href="/about-data">About the data</a>
    </nav>
  </div>
</header>
<main class="wrap">
  <slot />
</main>
<footer class="site">
  <div class="wrap">
    <p><strong>CostOfCare</strong> publishes price information, not medical or financial advice. Prices come from hospitals' federally required price-transparency files and providers' published self-pay rates. What you owe depends on your plan, deductible and the exact services billed - always ask the provider for a written estimate (your right under the No Surprises Act) before scheduling.</p>
    <p style="margin-top:8px">Austin, TX first. Data retrieved October 21, 2026 - sources and dates on the <a href="/about-data">data page</a>.</p>
  </div>
</footer>
</body>
</html>
